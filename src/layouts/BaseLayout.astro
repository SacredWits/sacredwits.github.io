---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeMeta, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  image?: string;
  /** Per-language URLs of this page; missing languages are shown as unavailable. */
  alternates?: Partial<Record<Locale, string>>;
}

const { lang, title, description, image, alternates } = Astro.props;
const meta = localeMeta[lang];
const siteName = t(lang, 'siteName');
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const desc = description ?? t(lang, 'tagline');

const fonts: Record<Locale, string> = {
  en: 'family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400',
  'ur-latn': 'family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400',
  ar: 'family=Amiri:ital,wght@0,400;0,700;1,400',
  ur: 'family=Noto+Nastaliq+Urdu:wght@400;600',
  hi: 'family=Noto+Serif+Devanagari:wght@400;600&family=Noto+Sans+Devanagari:wght@400;600',
};
const fontHref = `https://fonts.googleapis.com/css2?family=Inter:wght@400;600&${fonts[lang]}&display=swap`;
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {alternates &&
      Object.entries(alternates).map(([l, href]) => (
        <link rel="alternate" hreflang={localeMeta[l as Locale].htmlLang} href={new URL(href!, Astro.site)} />
      ))}
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
