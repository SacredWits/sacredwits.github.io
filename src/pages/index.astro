---
import { locales, localeMeta, defaultLocale } from '../i18n/locales';
import { homeUrl } from '../lib/urls';
const targets = Object.fromEntries(locales.map((l) => [l, homeUrl(l)]));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sacred Wits</title>
    <meta http-equiv="refresh" content={`2; url=${homeUrl(defaultLocale)}`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline define:vars={{ targets }}>
      const pref = (navigator.languages || [navigator.language]).map((l) => l.toLowerCase());
      const pick = pref.map((l) => (l.startsWith('ar') ? 'ar' : l.startsWith('ur') ? 'ur' : l.startsWith('hi') ? 'hi' : l.startsWith('en') ? 'en' : null)).find(Boolean);
      location.replace(targets[pick || 'en']);
    </script>
    <style>
      body { font-family: system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #fbf8f2; color: #1f1b16; }
      @media (prefers-color-scheme: dark) { body { background: #14120f; color: #ece6dc; } }
      ul { list-style: none; padding: 0; display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
      a { color: #0f6b5c; font-size: 1.1rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>Sacred Wits</h1>
      <ul>{locales.map((l) => <li><a href={homeUrl(l)} lang={localeMeta[l].htmlLang}>{localeMeta[l].name}</a></li>)}</ul>
    </main>
  </body>
</html>
