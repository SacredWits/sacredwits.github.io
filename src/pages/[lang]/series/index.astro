---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SeriesCard from '../../../components/SeriesCard.astro';
import { formats } from '../../../config/taxonomy';
import { t } from '../../../i18n/ui';
import { getSeries } from '../../../lib/content';
import { langPaths } from '../../../lib/paths';
import type { Locale } from '../../../i18n/locales';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const series = (await getSeries()).filter((s) => s.data.title[lang]);
---

<BaseLayout lang={lang} title={formats.series[lang]} description={t(lang, 'seriesIntro')}>
  <div class="container">
    <header class="page-head">
      <h1>{formats.series[lang]}</h1>
      <p>{t(lang, 'seriesIntro')}</p>
    </header>
    {series.length ? <div class="grid">{series.map((s) => <SeriesCard series={s} lang={lang} />)}</div> : <p class="empty">{t(lang, 'comingSoon')}</p>}
  </div>
</BaseLayout>
