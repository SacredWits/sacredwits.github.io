---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostView from '../../../../components/PostView.astro';
import { getAllPosts, getSeries, getTranslations, type Post } from '../../../../lib/content';

export async function getStaticPaths() {
  const posts = (await getAllPosts()).filter((p) => p.data.format === 'series');
  const series = await getSeries();
  return Promise.all(
    posts.map(async (post) => ({
      params: { lang: post.lang, series: post.data.series!, slug: post.slug },
      props: {
        post,
        alternates: await getTranslations(post.slug),
        seriesTitle: series.find((s) => s.id === post.data.series)?.data.title[post.lang],
      },
    })),
  );
}
const { post, alternates, seriesTitle } = Astro.props as {
  post: Post;
  alternates: Awaited<ReturnType<typeof getTranslations>>;
  seriesTitle?: string;
};
---

<BaseLayout lang={post.lang} title={post.data.title} description={post.data.description} image={post.data.cover?.src} alternates={alternates}>
  <PostView post={post} seriesTitle={seriesTitle} />
</BaseLayout>
