---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { sections, formats } from '../../../config/taxonomy';
import { t } from '../../../i18n/ui';
import { getPosts } from '../../../lib/content';
import { langPaths } from '../../../lib/paths';
import type { Locale } from '../../../i18n/locales';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const posts = await getPosts(lang, (p) => p.data.format === 'standalone');
const groups = sections.map((s) => ({ s, posts: posts.filter((p) => p.data.section === s.slug) })).filter((g) => g.posts.length);
---

<BaseLayout lang={lang} title={formats.articles[lang]} description={t(lang, 'articlesIntro')}>
  <div class="container">
    <header class="page-head">
      <h1>{formats.articles[lang]}</h1>
      <p>{t(lang, 'articlesIntro')}</p>
      {groups.length > 1 && <ul class="chips">{groups.map(({ s }) => <li><a href={`#${s.slug}`}>{s.label[lang]}</a></li>)}</ul>}
    </header>
    {
      groups.length ? (
        groups.map(({ s, posts }) => (
          <section id={s.slug}>
            <h2 class="section-title">{s.label[lang]}</h2>
            <PostGrid posts={posts} lang={lang} />
          </section>
        ))
      ) : (
        <PostGrid posts={[]} lang={lang} />
      )
    }
  </div>
</BaseLayout>
