---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostGrid from '../../../components/PostGrid.astro';
import SeriesCard from '../../../components/SeriesCard.astro';
import { sections, type Section } from '../../../config/taxonomy';
import { locales, type Locale } from '../../../i18n/locales';
import { t } from '../../../i18n/ui';
import { getPosts, getSeries } from '../../../lib/content';
import { sectionUrl, categoryUrl } from '../../../lib/urls';

export function getStaticPaths() {
  return locales.flatMap((lang) => sections.map((section) => ({ params: { lang, section: section.slug }, props: { lang, section } })));
}
const { lang, section } = Astro.props as { lang: Locale; section: Section };
// Section pages show standalone pieces; series parts are reached through their series.
const posts = await getPosts(lang, (p) => p.data.section === section.slug && p.data.format === 'standalone');
const series = (await getSeries()).filter((s) => s.data.section === section.slug && s.data.title[lang]);
---

<BaseLayout lang={lang} title={section.label[lang]} description={section.description[lang]}>
  <div class="container">
    <header class="page-head">
      <h1>{section.label[lang]}</h1>
      <p>{section.description[lang]}</p>
      {
        section.categories.length > 0 && (
          <ul class="chips">
            <li><a href={sectionUrl(lang, section.slug)} aria-current="page">{t(lang, 'all')}</a></li>
            {section.categories.map((c) => <li><a href={categoryUrl(lang, section.slug, c.slug)}>{c.label[lang]}</a></li>)}
          </ul>
        )
      }
    </header>
    {series.length > 0 && <div class="grid">{series.map((s) => <SeriesCard series={s} lang={lang} />)}</div>}
    <PostGrid posts={posts} lang={lang} />
  </div>
</BaseLayout>
