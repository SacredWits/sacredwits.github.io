---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostGrid from '../../../../components/PostGrid.astro';
import SeriesCard from '../../../../components/SeriesCard.astro';
import { sections, type Section, type Category } from '../../../../config/taxonomy';
import { locales, type Locale } from '../../../../i18n/locales';
import { t } from '../../../../i18n/ui';
import { getPosts, getSeries } from '../../../../lib/content';
import { sectionUrl, categoryUrl } from '../../../../lib/urls';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    sections.flatMap((section) =>
      section.categories.map((category) => ({
        params: { lang, section: section.slug, category: category.slug },
        props: { lang, section, category },
      })),
    ),
  );
}
const { lang, section, category } = Astro.props as { lang: Locale; section: Section; category: Category };
const posts = await getPosts(lang, (p) => p.data.section === section.slug && p.data.category === category.slug && p.data.format === 'standalone');
const series = (await getSeries()).filter((s) => s.data.section === section.slug && s.data.category === category.slug && s.data.title[lang]);
---

<BaseLayout lang={lang} title={`${category.label[lang]} · ${section.label[lang]}`}>
  <div class="container">
    <header class="page-head">
      <p class="crumb"><a href={sectionUrl(lang, section.slug)}>{section.label[lang]}</a></p>
      <h1>{category.label[lang]}</h1>
      <ul class="chips">
        <li><a href={sectionUrl(lang, section.slug)}>{t(lang, 'all')}</a></li>
        {
          section.categories.map((c) => (
            <li><a href={categoryUrl(lang, section.slug, c.slug)} aria-current={c.slug === category.slug ? 'page' : undefined}>{c.label[lang]}</a></li>
          ))
        }
      </ul>
    </header>
    {series.length > 0 && <div class="grid">{series.map((s) => <SeriesCard series={s} lang={lang} />)}</div>}
    <PostGrid posts={posts} lang={lang} />
  </div>
</BaseLayout>

<style>
  .crumb { margin: 0 0 4px; font-size: 0.9rem; }
</style>
