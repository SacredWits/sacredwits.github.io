---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostGrid from '../../components/PostGrid.astro';
import { sections, formats } from '../../config/taxonomy';
import { t } from '../../i18n/ui';
import { getPosts } from '../../lib/content';
import { langPaths } from '../../lib/paths';
import { sectionUrl, categoryUrl, articlesUrl, seriesIndexUrl } from '../../lib/urls';
import type { Locale } from '../../i18n/locales';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const latest = (await getPosts(lang)).slice(0, 6);
---

<BaseLayout lang={lang}>
  <section class="hero">
    <div class="container">
      <h1>{t(lang, 'siteName')}</h1>
      <p>{t(lang, 'tagline')}</p>
    </div>
  </section>

  <div class="container">
    <h2 class="section-title">{t(lang, 'latest')}</h2>
    <PostGrid posts={latest} lang={lang} />

    <h2 class="section-title">{t(lang, 'browse')}</h2>
    <div class="grid tiles">
      {
        sections.map((s) => (
          <div class="tile">
            <h3><a href={sectionUrl(lang, s.slug)}>{s.label[lang]}</a></h3>
            <p class="muted">{s.description[lang]}</p>
            {s.categories.length > 0 && (
              <ul class="chips">
                {s.categories.map((c) => <li><a href={categoryUrl(lang, s.slug, c.slug)}>{c.label[lang]}</a></li>)}
              </ul>
            )}
          </div>
        ))
      }
      <div class="tile">
        <h3><a href={articlesUrl(lang)}>{formats.articles[lang]}</a></h3>
        <p class="muted">{t(lang, 'articlesIntro')}</p>
      </div>
      <div class="tile">
        <h3><a href={seriesIndexUrl(lang)}>{formats.series[lang]}</a></h3>
        <p class="muted">{t(lang, 'seriesIntro')}</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero { padding-block: 56px 40px; background: linear-gradient(180deg, var(--accent-soft), transparent); border-bottom: 1px solid var(--border); }
  .hero h1 { margin: 0; font-family: var(--font-body); font-size: clamp(2rem, 5vw, 3rem); }
  .hero p { margin: 8px 0 0; color: var(--muted); font-size: 1.15rem; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
  .tile h3 { margin: 0 0 6px; font-family: var(--font-body); }
  .tile p { margin: 0; }
</style>
