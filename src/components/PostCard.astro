---
import { Image } from 'astro:assets';
import type { Post } from '../lib/content';
import { postUrl } from '../lib/content';
import { getSection, getCategory } from '../config/taxonomy';
import { t } from '../i18n/ui';

interface Props { post: Post; seriesTitle?: string }
const { post, seriesTitle } = Astro.props;
const { data, lang } = post;
const section = getSection(data.section);
const category = getCategory(data.section, data.category);
---

<article class="card">
  <a href={postUrl(post)} class="cover">
    {data.cover && <Image src={data.cover} alt={data.coverAlt ?? ''} width={640} quality={70} loading="lazy" />}
  </a>
  <div class="body">
    <p class="meta">
      {
        data.format === 'series' ? (
          <span class="badge series">{t(lang, 'partOf', { n: data.part ?? '' })} {seriesTitle ?? data.series}</span>
        ) : (
          <span class="badge">{t(lang, 'standalone')}</span>
        )
      }
      <span class="muted">{category?.label[lang] ?? section?.label[lang]}</span>
    </p>
    <h3><a href={postUrl(post)}>{data.title}</a></h3>
    <p class="muted desc">{data.description}</p>
  </div>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .cover { aspect-ratio: 16 / 9; background: var(--accent-soft); display: block; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: 16px 18px 20px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 8px; font-size: 0.85rem; }
  h3 { margin: 0 0 8px; font-family: var(--font-body); font-size: 1.2rem; line-height: 1.5; }
  h3 a { color: var(--text); }
  .desc { margin: 0; font-size: 0.95rem; }
</style>
