---
import { Image } from 'astro:assets';
import { articleUrl, type Post } from '../lib/content';
import { getTopic, getCategory } from '../config/taxonomy';
import { t } from '../i18n/ui';

interface Props { post: Post }
const { post } = Astro.props;
const { data, lang } = post;
const topic = getTopic(data.topic);
const category = getCategory(data.topic, data.category);
const href = articleUrl(post);
---

<article class="card">
  <a href={href} class="cover" tabindex="-1" aria-hidden="true">
    {data.cover && <Image src={data.cover} alt="" width={640} quality={70} loading="lazy" />}
  </a>
  <div class="body">
    <p class="meta">
      <span class="badge">{t(lang, 'article')}</span>
      <span class="muted">{category?.label[lang] ?? topic?.label[lang]}</span>
    </p>
    <h3><a href={href}>{data.title}</a></h3>
    <p class="muted desc">{data.description}</p>
  </div>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .cover { aspect-ratio: 16 / 9; background: var(--accent-soft); display: block; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: 16px 18px 20px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 8px; font-size: 0.85rem; }
  h3 { margin: 0 0 8px; font-family: var(--font-body); font-size: 1.2rem; line-height: 1.5; }
  h3 a { color: var(--text); }
  .desc { margin: 0; font-size: 0.95rem; }
</style>
