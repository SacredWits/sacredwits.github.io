---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { sections, formats } from '../config/taxonomy';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { homeUrl, sectionUrl, categoryUrl, articlesUrl, seriesIndexUrl } from '../lib/urls';

interface Props {
  lang: Locale;
  alternates?: Partial<Record<Locale, string>>;
}
const { lang, alternates } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);

const [seerah, quran, ...rest] = sections;
const withMenus = [seerah, quran];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={homeUrl(lang)}>
      <img src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="28" height="28" />
      <span>{t(lang, 'siteName')}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span aria-hidden="true">☰</span>
      <span class="visually-hidden">{t(lang, 'menu')}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={t(lang, 'menu')}>
      <ul class="nav-list">
        {
          withMenus.map((s) => (
            <li class="has-sub">
              <details class="dropdown">
                <summary class:list={{ active: isActive(sectionUrl(lang, s.slug)) }}>{s.label[lang]}</summary>
                <ul class="sub">
                  <li><a href={sectionUrl(lang, s.slug)}>{t(lang, 'all')}</a></li>
                  {s.categories.map((c) => (
                    <li>
                      <a href={categoryUrl(lang, s.slug, c.slug)} aria-current={path === categoryUrl(lang, s.slug, c.slug) ? 'page' : undefined}>
                        {c.label[lang]}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
        <li class="sep" aria-hidden="true"></li>
        <li><a class:list={{ active: isActive(articlesUrl(lang)) }} href={articlesUrl(lang)}>{formats.articles[lang]}</a></li>
        <li><a class:list={{ active: isActive(seriesIndexUrl(lang)) }} href={seriesIndexUrl(lang)}>{formats.series[lang]}</a></li>
        <li class="sep" aria-hidden="true"></li>
        {
          rest.map((s) => (
            <li>
              <a class:list={{ active: isActive(sectionUrl(lang, s.slug)) }} href={sectionUrl(lang, s.slug)}>{s.label[lang]}</a>
            </li>
          ))
        }
      </ul>
      <LanguageSwitcher lang={lang} alternates={alternates} />
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; gap: 16px; min-height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--text); font-family: 'Inter', system-ui, sans-serif; white-space: nowrap; }
  .brand:hover { text-decoration: none; }
  .menu-toggle { display: none; margin-inline-start: auto; background: none; border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; font-size: 1.2rem; color: var(--text); cursor: pointer; }
  .nav { display: flex; align-items: center; gap: 12px; flex: 1; }
  .nav-list { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; flex: 1; flex-wrap: wrap; }
  .nav-list > li > a, summary { display: block; padding: 8px 10px; border-radius: 8px; color: var(--text); font-size: 0.95rem; cursor: pointer; white-space: nowrap; }
  .nav-list > li > a:hover, summary:hover { background: var(--accent-soft); text-decoration: none; }
  .active { color: var(--accent) !important; font-weight: 600; }
  .sep { width: 1px; height: 20px; background: var(--border); margin-inline: 6px; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '▾'; margin-inline-start: 6px; font-size: 0.75em; color: var(--muted); }
  .has-sub { position: relative; }
  .sub { position: absolute; inset-inline-start: 0; top: calc(100% + 4px); min-width: 220px; list-style: none; margin: 0; padding: 6px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .sub a { display: block; padding: 8px 12px; border-radius: 8px; color: var(--text); }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--accent-soft); text-decoration: none; }

  @media (max-width: 1000px) {
    .menu-toggle { display: block; }
    .nav { display: none; position: absolute; inset-inline: 0; top: 100%; flex-direction: column; align-items: stretch; background: var(--bg); border-bottom: 1px solid var(--border); padding: 12px 16px 20px; }
    .nav.open { display: flex; }
    .nav-list { flex-direction: column; align-items: stretch; }
    .sep { width: auto; height: 1px; margin: 8px 0; }
    .sub { position: static; box-shadow: none; border: 0; padding: 0 0 0 0; padding-inline-start: 12px; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  // Close open dropdowns when clicking elsewhere or opening another one.
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.site-header details'));
  document.addEventListener('click', (e) => {
    for (const d of dropdowns) if (!d.contains(e.target as Node)) d.open = false;
  });
  for (const d of dropdowns) {
    d.addEventListener('toggle', () => {
      if (d.open) for (const o of dropdowns) if (o !== d) o.open = false;
    });
  }
</script>
