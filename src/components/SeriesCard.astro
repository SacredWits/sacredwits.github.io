---
import { Image } from 'astro:assets';
import type { Series } from '../lib/content';
import { getSeriesParts } from '../lib/content';
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { formats } from '../config/taxonomy';
import { seriesUrl } from '../lib/urls';

interface Props { series: Series; lang: Locale }
const { series, lang } = Astro.props;
const parts = await getSeriesParts(lang, series.id);
const href = seriesUrl(lang, series.id);
---

<article class="card">
  <a href={href} class="cover">{series.data.cover && <Image src={series.data.cover} alt="" width={640} quality={70} loading="lazy" />}</a>
  <div class="body">
    <p class="meta"><span class="badge series">{formats.series[lang]}</span> <span class="muted">{parts.length} {t(lang, 'parts')}</span></p>
    <h3><a href={href}>{series.data.title[lang]}</a></h3>
    <p class="muted desc">{series.data.description[lang]}</p>
  </div>
</article>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .cover { aspect-ratio: 16 / 9; background: color-mix(in srgb, var(--gold) 15%, transparent); display: block; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: 16px 18px 20px; }
  .meta { display: flex; gap: 8px; align-items: center; margin: 0 0 8px; font-size: 0.85rem; }
  h3 { margin: 0 0 8px; font-family: var(--font-body); font-size: 1.2rem; }
  h3 a { color: var(--text); }
  .desc { margin: 0; font-size: 0.95rem; }
</style>
